---
import { siteConfig } from "../config";

const contact = siteConfig.contact;
const fieldClass =
  "w-full rounded-xl border border-edge bg-night px-4 py-3 text-sm text-ink placeholder:text-subtle outline-none transition-colors duration-[450ms] ease-snap focus:border-lime";
const tileClass =
  "flex items-center gap-4 rounded-2xl border border-edge bg-night/60 p-5 transition-colors duration-[450ms] ease-snap hover:border-lime/50";
const iconClass = "flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-lime/10 text-lime";
---

{
  contact && (
    <section id="contato" class="py-24 md:py-28">
      <div class="mx-auto max-w-5xl px-5">
        <div class="kl-gradient-border rounded-3xl p-px">
          <div class="rounded-3xl bg-surface px-6 py-12 md:px-12 md:py-16">
            <div class="mx-auto max-w-2xl text-center">
              <span class="inline-flex items-center gap-2 rounded-full border border-edge px-3.5 py-1 text-xs text-subtle">
                <span class="h-1.5 w-1.5 rounded-full bg-lime"></span>
                Vamos conversar
              </span>
              <h2 class="mt-5 font-display text-3xl font-semibold tracking-tight md:text-4xl">
                {contact.title}{" "}<span class="kl-gradient-text">{contact.highlight}</span>
              </h2>
              <p class="mt-5 text-base leading-7 text-subtle">{contact.text}</p>
            </div>

            <div class="mt-12 grid gap-4 md:grid-cols-3">
              {contact.email && (
                <a href={`mailto:${contact.email}`} class={tileClass}>
                  <span class={iconClass}>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path><path d="M3 7l9 6l9 -6"></path></svg>
                  </span>
                  <span class="min-w-0">
                    <span class="block text-xs text-subtle">E-mail</span>
                    <span class="block truncate text-sm font-medium">{contact.email}</span>
                  </span>
                </a>
              )}
              {contact.whatsapp && (
                <a href={`https://wa.me/55${contact.whatsapp.replace(/\D/g, "")}`} target="_blank" rel="noopener noreferrer" class={tileClass}>
                  <span class={iconClass}>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"></path></svg>
                  </span>
                  <span>
                    <span class="block text-xs text-subtle">WhatsApp</span>
                    <span class="block text-sm font-medium">{contact.whatsapp}</span>
                  </span>
                </a>
              )}
              {contact.address && (
                <div class={tileClass}>
                  <span class={iconClass}>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"></path></svg>
                  </span>
                  <span>
                    <span class="block text-xs text-subtle">Localização</span>
                    <span class="block text-sm font-medium">{contact.address}</span>
                  </span>
                </div>
              )}
            </div>

            {contact.formAction && (
              <form action={contact.formAction} method="POST" class="mx-auto mt-10 grid max-w-2xl gap-4 sm:grid-cols-2">
                <input name="nome" required placeholder="Nome" class={fieldClass} />
                <input name="email" type="email" required placeholder="E-mail" class={fieldClass} />
                <input name="assunto" placeholder="Assunto" class:list={[fieldClass, "sm:col-span-2"]} />
                <textarea name="mensagem" required rows="5" placeholder="Mensagem" class:list={[fieldClass, "resize-none sm:col-span-2"]}></textarea>
                <button type="submit" class="kl-gradient cursor-pointer rounded-xl px-6 py-3 text-sm font-medium text-night transition-[transform,box-shadow] duration-[450ms] ease-snap hover:-translate-y-0.5 hover:shadow-glow sm:col-span-2">
                  Enviar mensagem
                </button>
              </form>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

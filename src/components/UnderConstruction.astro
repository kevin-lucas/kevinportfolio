---
import { siteConfig } from "../config";

const { social, contact } = siteConfig;
const initials = siteConfig.name
  .split(" ")
  .map((part) => part.charAt(0))
  .join("")
  .slice(0, 2);

const linkClass =
  "inline-flex items-center gap-2 rounded-xl border border-edge px-5 py-3 text-sm font-medium text-ink transition-colors duration-[450ms] ease-snap hover:border-lime hover:text-lime";
---

<section id="em-construcao" class="relative flex min-h-screen flex-col overflow-hidden">
  <div class="kl-grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="kl-glow pointer-events-none absolute left-1/2 top-1/3 h-[560px] w-[560px] -translate-x-1/2 -translate-y-1/2" aria-hidden="true"></div>

  <div class="relative mx-auto flex w-full max-w-3xl flex-1 flex-col items-center justify-center px-5 py-20 text-center">
    <span class="kl-gradient flex h-14 items-center justify-center rounded-2xl px-4 font-display text-xl font-semibold tracking-tight text-night" aria-hidden="true">
      <span class="opacity-60">{"</"}</span>{initials}<span class="opacity-60">{">"}</span>
    </span>

    <span class="mt-8 inline-flex items-center gap-2 rounded-full border border-edge bg-surface/70 px-4 py-1.5 text-xs text-subtle">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-lime opacity-60"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-lime"></span>
      </span>
      Em construção
    </span>

    <h1 class="mt-6 font-display text-4xl font-semibold leading-[1.1] tracking-tight sm:text-5xl">
      Meu novo portfólio está quase <span class="kl-gradient-text">pronto</span>
    </h1>
    <p class="mt-6 max-w-xl text-base leading-7 text-subtle">
      Sou {siteConfig.name}, {siteConfig.title.toLowerCase()}. Estou finalizando os últimos detalhes por aqui. Enquanto isso, fale comigo pelos canais abaixo.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      {
        contact?.whatsapp && (
          <a href={`https://wa.me/55${contact.whatsapp.replace(/\D/g, "")}`} target="_blank" rel="noopener noreferrer" class="kl-gradient inline-flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-medium text-night transition-[transform,box-shadow] duration-[450ms] ease-snap hover:-translate-y-0.5 hover:shadow-glow">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"></path></svg>
            WhatsApp
          </a>
        )
      }
      {
        social.email && (
          <a href={`mailto:${social.email}`} class={linkClass}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path><path d="M3 7l9 6l9 -6"></path></svg>
            E-mail
          </a>
        )
      }
      {
        social.linkedin && (
          <a href={social.linkedin} target="_blank" rel="noopener noreferrer" class={linkClass}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M8 11v5"></path><path d="M8 8v.01"></path><path d="M12 16v-5"></path><path d="M16 16v-3a2 2 0 1 0 -4 0"></path><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z"></path></svg>
            LinkedIn
          </a>
        )
      }
      {
        social.github && (
          <a href={social.github} target="_blank" rel="noopener noreferrer" class={linkClass}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path></svg>
            GitHub
          </a>
        )
      }
    </div>
  </div>

  <p class="relative pb-8 text-center text-sm text-subtle">© {new Date().getFullYear()} {siteConfig.name}</p>
</section>

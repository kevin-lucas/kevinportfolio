---
import { siteConfig } from "../config";

const hero = siteConfig.hero;
const chipPositions = ["-left-4 top-10", "-right-3 top-10", "left-6 -bottom-4"];
---

{
  hero && (
    <section id="inicio" class="relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28">
      <div class="kl-grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="kl-glow pointer-events-none absolute -top-20 right-[-10%] h-[520px] w-[520px]" aria-hidden="true"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-5 md:grid-cols-[1.15fr_0.85fr]">
        <div>
          {hero.badge && (
            <span class="inline-flex items-center gap-2 rounded-full border border-edge bg-surface/70 px-4 py-1.5 text-xs text-subtle">
              <span class="h-1.5 w-1.5 rounded-full bg-lime shadow-[0_0_10px_var(--color-lime)]"></span>
              {hero.badge}
            </span>
          )}
          <h1 class="mt-6 font-display text-4xl font-semibold leading-[1.1] tracking-tight sm:text-5xl lg:text-[3.5rem]">
            {hero.title}{" "}<span class="kl-gradient-text">{hero.highlight}</span>
          </h1>
          <p class="mt-6 max-w-xl text-base leading-7 text-subtle">{hero.text}</p>

          <div class="mt-9 flex flex-wrap gap-3">
            <a href={hero.primary.link} class="kl-gradient inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-medium text-night transition-[transform,box-shadow] duration-[450ms] ease-snap hover:-translate-y-0.5 hover:shadow-glow">
              {hero.primary.label}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path d="M13 6l6 6"></path></svg>
            </a>
            <a href={hero.secondary.link} class="inline-flex items-center rounded-xl border border-edge px-6 py-3 text-sm font-medium text-ink transition-colors duration-[450ms] ease-snap hover:border-lime hover:text-lime">
              {hero.secondary.label}
            </a>
          </div>

          {hero.stats?.length > 0 && (
            <dl class="mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-edge pt-8">
              {hero.stats.map((stat) => (
                <div>
                  <dt class="font-display text-2xl font-semibold text-ink sm:text-3xl">{stat.value}</dt>
                  <dd class="mt-1 text-xs leading-5 text-subtle">{stat.label}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>

        <div class="relative mx-auto w-full max-w-sm">
          <div class="kl-gradient-border rounded-3xl p-px">
            <div class="overflow-hidden rounded-3xl bg-surface">
              <img src={hero.image} alt={siteConfig.name} width="500" height="620" fetchpriority="high" decoding="async" class="aspect-[4/5] w-full object-cover" />
            </div>
          </div>
          {hero.chips?.map((chip, i) => (
            <span class:list={["absolute hidden rounded-full border border-edge bg-night/90 px-3.5 py-1.5 text-xs font-medium text-ink shadow-glow backdrop-blur sm:block", chipPositions[i % chipPositions.length]]}>
              {chip}
            </span>
          ))}
        </div>
      </div>
    </section>
  )
}

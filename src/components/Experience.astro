---
import { siteConfig } from "../config";

const experience = siteConfig.experience ?? [];
---

{
  experience.length > 0 && (
    <section id="trajetoria" class="py-24 md:py-28">
      <div class="mx-auto max-w-6xl px-5">
        <div class="max-w-2xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-edge px-3.5 py-1 text-xs text-subtle">
            <span class="h-1.5 w-1.5 rounded-full bg-lime"></span>
            Trajetória
          </span>
          <h2 class="mt-5 font-display text-3xl font-semibold tracking-tight md:text-4xl">
            Onde construí minha <span class="kl-gradient-text">experiência</span>
          </h2>
          {siteConfig.experienceIntro && (
            <p class="mt-5 text-base leading-7 text-subtle">{siteConfig.experienceIntro}</p>
          )}
        </div>

        <ol class="relative mt-14 space-y-6 border-l border-edge pl-8 md:ml-4">
          {experience.map((item) => (
            <li class="relative">
              <span class="absolute -left-[39px] top-7 h-3.5 w-3.5 rounded-full border-[3px] border-night bg-lime shadow-[0_0_0_1px_var(--color-lime)]" aria-hidden="true"></span>
              <article class="rounded-2xl border border-edge bg-surface p-6 transition-colors duration-[450ms] ease-snap hover:border-lime/50 md:p-7">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <h3 class="font-display text-xl font-semibold">{item.company}</h3>
                  <span class="rounded-full bg-lime/10 px-3 py-1 text-xs font-medium text-lime">{item.period}</span>
                </div>
                <p class="mt-1 text-sm text-ink/80">{item.role}</p>
                <p class="mt-4 text-sm leading-6 text-subtle">{item.text}</p>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
